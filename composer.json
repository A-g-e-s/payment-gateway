{
    "name": "ages/payment-gateway",
    "description": "Unified payment gateway API for Comgate and GoPay",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "gopay/payments-sdk-php": "^1.11",
        "contributte/comgate": "^0.5.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ages\\PaymentGateway\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse"
    }
}

